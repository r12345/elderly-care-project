# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会进仓库。
# djangoProject/settings.py 启动时会自动读取本文件。

# ===== Django =====
# 生产环境务必换成新生成的随机串（可用 python -c "from django.core.management.utils import get_random_secret_key as g;print(g())"）
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
# 逗号分隔，例如 localhost,127.0.0.1,example.com
DJANGO_ALLOWED_HOSTS=

# ===== MySQL =====
DB_NAME=fire
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
